{
  "name": "cmx-harness",
  "version": "0.1.0",
  "private": true,
  "description": "DevOps 研发交付 Harness - 面向单研发团队的一体化研发交付平台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import tsx --test --test-concurrency=1 $(find test -name '*.test.ts' -o -name '*.test.js')",
    "test:unit": "node --test src/domain src/modules",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "next": "15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
